{
  "name": "pdf-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:eslint": "tsc --noEmit",
    "test": "npm run test:netlify && npm run test:service",
    "test:netlify": "rm -rf .tmp-tests && tsc -p tsconfig.test.json && node --test .tmp-tests/tests/agent-artifact*.test.js",
    "test:service": "npm --prefix render-service run test",
    "goldens:image-annotate:update": "rm -rf .tmp-tests && tsc -p tsconfig.test.json && UPDATE_IMAGE_ANNOTATE_GOLDENS=1 node --test .tmp-tests/tests/agent-artifact-image-annotate-goldens.test.js",
    "goldens:image-annotate:png:update": "UPDATE_IMAGE_ANNOTATE_PNG_GOLDEN=1 npm --prefix render-service run test",
    "docs:generate": "tsx scripts/generate-reference.mts",
    "docs:check": "rm -rf .tmp-docs && tsx scripts/generate-reference.mts --out .tmp-docs && diff -u docs/MCP_REFERENCE.md .tmp-docs/MCP_REFERENCE.md && diff -u docs/HTTP_REFERENCE.md .tmp-docs/HTTP_REFERENCE.md && rm -rf .tmp-docs"
  },
  "dependencies": {
    "@netlify/blobs": "^9.1.2",
    "@openai/agents": "^0.1.0",
    "@pdfme/common": "^6.1.10",
    "@pdfme/generator": "^6.1.10",
    "@pdfme/pdf-lib": "^6.1.11",
    "@pdfme/schemas": "^6.1.10",
    "@react-pdf/renderer": "^4.5.1",
    "ajv": "^8.20.0",
    "fflate": "^0.8.3",
    "liquidjs": "^10.27.2",
    "openai": "^6.10.0",
    "react": "^19.2.7",
    "robots-parser": "^3.0.1",
    "sharp": "^0.35.2",
    "zod": "^3.25.40"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
