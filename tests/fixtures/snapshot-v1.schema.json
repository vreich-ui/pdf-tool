{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.invalid/contracts/snapshot.v1.schema.json",
  "title": "Site capture snapshot.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "capture", "pages", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": "snapshot.v1" },
    "capture": {
      "type": "object",
      "required": [
        "targetUrl",
        "origin",
        "capturedAt",
        "localOnly",
        "redacted",
        "contentTreatment",
        "crawler",
        "policy",
        "robots",
        "viewports"
      ],
      "properties": {
        "targetUrl": { "type": "string", "format": "uri" },
        "origin": { "type": "string", "format": "uri" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "localOnly": { "const": true },
        "redacted": { "type": "boolean" },
        "redaction": { "type": "object" },
        "contentTreatment": { "type": "string" },
        "crawler": { "type": "object" },
        "policy": { "type": "object" },
        "robots": { "type": "object" },
        "viewports": { "type": "array", "minItems": 1, "items": { "type": "object" } }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pageId",
          "requestedUrl",
          "url",
          "path",
          "status",
          "title",
          "outline",
          "blocks",
          "assets",
          "navigation",
          "discoveredLinks",
          "screenshots"
        ],
        "properties": {
          "pageId": { "type": "string", "pattern": "^page_[a-f0-9]{12}$" },
          "requestedUrl": { "type": "string", "format": "uri" },
          "url": { "type": "string", "format": "uri" },
          "path": { "type": "string" },
          "status": { "type": "integer", "minimum": 100, "maximum": 399 },
          "capturedAt": { "type": "string", "format": "date-time" },
          "title": { "type": "string" },
          "lang": { "type": ["string", "null"] },
          "canonicalUrl": { "type": ["string", "null"] },
          "metaDescription": { "type": ["string", "null"] },
          "outline": { "type": "array", "items": { "type": "object" } },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "ordinal",
                "tag",
                "selector",
                "text",
                "links",
                "boundingBoxes",
                "computedStyles",
                "screenshots",
                "assetUrls"
              ],
              "properties": {
                "id": { "type": "string" },
                "ordinal": { "type": "integer", "minimum": 0 },
                "tag": { "type": "string" },
                "role": { "type": ["string", "null"] },
                "accessibleName": { "type": ["string", "null"] },
                "selector": { "type": "string" },
                "text": { "type": "object" },
                "links": { "type": "array", "items": { "type": "object" } },
                "boundingBoxes": { "type": "object" },
                "computedStyles": { "type": "object" },
                "screenshots": { "type": "array", "items": { "type": "object" } },
                "assetUrls": { "type": "array", "items": { "type": "string", "format": "uri" } }
              }
            }
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["url", "kind", "downloaded", "capturable", "notCapturableReason"],
              "properties": {
                "id": { "type": "string", "pattern": "^page_[a-f0-9]{12}_asset_\\d{3}$" },
                "url": { "type": "string", "format": "uri" },
                "kind": { "type": "string", "enum": ["image", "media", "video", "poster", "document", "background-image"] },
                "alt": { "type": ["string", "null"] },
                "referencedBy": { "type": ["string", "null"] },
                "srcset": { "type": ["string", "null"] },
                "label": { "type": ["string", "null"] },
                "downloaded": { "type": "boolean" },
                "capturable": { "type": "boolean" },
                "notCapturableReason": {
                  "type": ["string", "null"],
                  "enum": ["rights_prohibited", "worker_deadline_reached", "job_asset_byte_cap_reached", "oversize", "blocked_url", "fetch_failed", null]
                },
                "storedArtifact": {
                  "type": "object",
                  "required": ["path", "sha256", "contentType", "byteLength"],
                  "properties": {
                    "path": { "type": "string" },
                    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                    "contentType": { "type": "string" },
                    "byteLength": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            }
          },
          "embeds": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "ordinal",
                "tag",
                "provider",
                "src",
                "selector",
                "boundingBoxes",
                "capturable",
                "notCapturableReason"
              ],
              "properties": {
                "id": { "type": "string", "pattern": "^page_[a-f0-9]{12}_embed_\\d{3}$" },
                "ordinal": { "type": "integer", "minimum": 0 },
                "tag": { "type": "string", "enum": ["iframe", "embed", "object"] },
                "provider": { "type": "string", "enum": ["video", "maps", "booking", "social", "unknown"] },
                "src": { "type": ["string", "null"], "format": "uri" },
                "rawSrc": { "type": ["string", "null"] },
                "providerHost": { "type": ["string", "null"] },
                "title": { "type": ["string", "null"] },
                "accessibleName": { "type": ["string", "null"] },
                "selector": { "type": "string" },
                "containingBlockId": { "type": ["string", "null"] },
                "attributes": { "type": "object" },
                "boundingBoxes": { "type": "object" },
                "capturable": { "type": "boolean" },
                "notCapturableReason": {
                  "type": ["string", "null"],
                  "enum": ["missing-src", "unsupported-scheme", "invalid-src", null]
                }
              }
            }
          },
          "fonts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "ordinal", "kind", "capturable", "notCapturableReason"],
              "properties": {
                "id": { "type": "string", "pattern": "^page_[a-f0-9]{12}_font_\\d{3}$" },
                "ordinal": { "type": "integer", "minimum": 0 },
                "kind": { "type": "string", "enum": ["face", "provider-link"] },
                "family": { "type": ["string", "null"] },
                "weight": {
                  "type": "object",
                  "properties": {
                    "raw": { "type": "string" },
                    "min": { "type": ["number", "null"] },
                    "max": { "type": ["number", "null"] }
                  }
                },
                "style": {
                  "type": "object",
                  "properties": {
                    "raw": { "type": "string" },
                    "kind": { "type": "string", "enum": ["normal", "italic", "oblique"] }
                  }
                },
                "unicodeRange": { "type": ["string", "null"] },
                "stylesheetHref": { "type": ["string", "null"] },
                "provider": { "type": ["string", "null"] },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": { "type": "string", "enum": ["url", "local"] },
                      "rawUrl": { "type": ["string", "null"] },
                      "url": { "type": ["string", "null"] },
                      "format": { "type": ["string", "null"] },
                      "tech": { "type": ["string", "null"] },
                      "localName": { "type": ["string", "null"] }
                    }
                  }
                },
                "href": { "type": ["string", "null"] },
                "families": { "type": "array", "items": { "type": "string" } },
                "capturable": { "type": "boolean" },
                "notCapturableReason": {
                  "type": ["string", "null"],
                  "enum": ["no-src-declared", "invalid-src", "local-only", "unsupported-scheme", "invalid-href", null]
                }
              }
            }
          },
          "navigation": { "type": "object" },
          "discoveredLinks": { "type": "array", "items": { "type": "string", "format": "uri" } },
          "screenshots": { "type": "array", "items": { "type": "object" } }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "required": ["queuedUrls", "capturedPages", "skipped", "quarantined", "stoppedAtProjectMaxPages"],
      "properties": {
        "queuedUrls": { "type": "integer", "minimum": 0 },
        "capturedPages": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "array" },
        "quarantined": { "type": "array" },
        "stoppedAtProjectMaxPages": { "type": "boolean" }
      }
    }
  }
}
